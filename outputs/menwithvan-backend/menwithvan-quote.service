[Unit]
Description=Men With A Van quote API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/menwithvan/quote.env
WorkingDirectory=/opt/menwithvan/backend
ExecStart=/usr/bin/python3 /opt/menwithvan/backend/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/menwithvan /var/log

[Install]
WantedBy=multi-user.target
